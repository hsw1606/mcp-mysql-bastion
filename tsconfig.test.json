{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./*.ts", "./src/**/*.ts", "./test/**/*.ts"],
  // `tsconfig.json`의 exclude를 그대로 물려받으면 vitest.config.ts가 빠진다.
  // 거기서 뺀 이유는 `npm run build`가 dist에 내보내지 않게 하려는 것뿐인데,
  // 그대로 두면 저장소에서 아무도 타입 검사하지 않는 유일한 .ts가 된다.
  "exclude": ["node_modules"]
}
