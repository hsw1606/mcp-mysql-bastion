{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "pretty": false,
    "stripInternal": true,
    "newLine": "lf"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": [
    "./*.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // 루트의 `./*.ts`에 걸리지만 서버의 일부가 아니다. 빼지 않으면
    // `npm run build`가 dist/vitest.config.js를 같이 내보낸다.
    "vitest.config.ts"
  ]
}
