# =============================================================================
# mcp-server-mysql — profile template
# =============================================================================
# Copy this file to `.env.stage` / `.env.prod` and fill in real values there.
# Those files are gitignored; never put a password, key path, or hostname you
# care about into a file that is committed.
#
# A profile is selected by the wrapper scripts in `bin/`, which export
# MYSQL_PROFILE and then load the matching `.env.<profile>`.
# -----------------------------------------------------------------------------

# --- Profile -----------------------------------------------------------------
# Free-form label, surfaced in the tool description and in every query result.
# The values `prod` and `production` additionally make the server refuse write
# operations at the code level — no environment variable can re-enable them.
MYSQL_PROFILE=stage

# --- SSH tunnel --------------------------------------------------------------
# When enabled, an SSH tunnel is opened before the MySQL pool is created and is
# closed again on shutdown. The pool connects to 127.0.0.1:<local port>.
MYSQL_SSH_ENABLED=true

# The simplest setup: name a Host alias from ~/.ssh/config and let the server
# read HostName, User, Port, IdentityFile and the first LocalForward from it.
# Anything set explicitly below still wins over the alias.
MYSQL_SSH_CONFIG_HOST=my-bastion-alias

# Explicit bastion settings — required only when no alias is used, or to
# override individual fields from the alias.
#MYSQL_SSH_HOST=bastion.example.internal
#MYSQL_SSH_PORT=22
#MYSQL_SSH_USER=ec2-user

# Key used to authenticate to the bastion. Defaults to ~/.ssh/id_rsa.
# MYSQL_SSH_PASSPHRASE is only needed for an encrypted key.
#MYSQL_SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
#MYSQL_SSH_PASSPHRASE=

# Loopback port the tunnel listens on. 0 auto-assigns a free port.
# Defaults to the alias's LocalForward port when one is available.
# If this port is already accepting connections, the existing forward is
# reused instead of opening a duplicate tunnel.
#MYSQL_SSH_LOCAL_PORT=0

# --- MySQL -------------------------------------------------------------------
# With a tunnel, MYSQL_HOST/MYSQL_PORT describe the database as seen *from the
# bastion*. They are the forwarding target, not the address the pool dials.
# An alias's LocalForward target takes precedence over them.
MYSQL_HOST=db.cluster-ro.example.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASS=your_password

# Leave empty for multi-DB mode (SHOW DATABASES, cross-schema queries).
# Set to a database name to scope the server to one schema.
MYSQL_DB=

# --- Write permissions -------------------------------------------------------
# All four default to false. They are forced to false regardless of value when
# MYSQL_PROFILE is prod/production.
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false
MULTI_DB_WRITE_MODE=false

# --- Diagnostics -------------------------------------------------------------
# Safe to enable with any MCP client: all logging goes to stderr, never stdout.
ENABLE_LOGGING=false
MYSQL_LOG_LEVEL=info
