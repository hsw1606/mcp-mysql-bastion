# =============================================================================
# mcp-server-mysql — profile 템플릿
# =============================================================================
# 이 파일을 `.env.stage` / `.env.prod`로 복사한 뒤 실제 값은 거기에 채운다.
# 그 파일들은 gitignore 대상이다. 비밀번호, 키 경로, 아껴야 할 호스트 이름은
# 커밋되는 파일에 절대 적지 않는다.
#
# profile은 `bin/`의 wrapper 스크립트가 고른다. MYSQL_PROFILE을 export한 뒤
# 그에 맞는 `.env.<profile>`을 읽는다.
# -----------------------------------------------------------------------------

# --- Profile -----------------------------------------------------------------
# 자유 형식 라벨. 도구 설명과 모든 쿼리 결과에 드러난다.
# `prod`와 `production`은 여기에 더해 서버가 쓰기를 코드 수준에서 거절하게
# 만든다. 어떤 환경변수로도 되살릴 수 없다.
MYSQL_PROFILE=stage

# --- SSH tunnel --------------------------------------------------------------
# 켜면 MySQL pool을 만들기 전에 SSH tunnel을 열고 종료할 때 닫는다.
# pool은 127.0.0.1:<로컬 포트>로 접속한다.
MYSQL_SSH_ENABLED=true

# 가장 간단한 설정. ~/.ssh/config의 Host alias 이름만 적으면 서버가 거기서
# HostName, User, Port, IdentityFile, 그리고 첫 LocalForward를 읽는다.
# 아래에 명시한 값은 alias보다 우선한다.
MYSQL_SSH_CONFIG_HOST=my-bastion-alias

# bastion을 직접 적는 설정. alias를 쓰지 않을 때, 또는 alias의 특정 항목만
# 덮어쓸 때만 필요하다.
#MYSQL_SSH_HOST=bastion.example.internal
#MYSQL_SSH_PORT=22
#MYSQL_SSH_USER=ec2-user

# bastion에 인증할 키. 기본값은 ~/.ssh/id_rsa.
# MYSQL_SSH_PASSPHRASE는 암호화된 키에만 필요하다.
#MYSQL_SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
#MYSQL_SSH_PASSPHRASE=

# tunnel이 열어 둘 loopback 포트. 0이면 빈 포트를 자동으로 고른다.
# alias에 LocalForward가 있으면 그 포트가 기본값이 된다.
# 포트가 이미 쓰이고 있으면, 그 tunnel을 같이 쓰지 않고 자동 할당 포트에
# 자기 tunnel을 연다.
#MYSQL_SSH_LOCAL_PORT=0

# 위 포트에서 이미 듣고 있는 forward에 붙는다. 직접 열지 않는다.
# 기본은 꺼짐. 빌려 쓴 tunnel은 그것을 연 프로세스가 끝나는 순간 같이 죽고,
# 그러면 진행 중인 쿼리가 끊긴다. 외부에서 오래 관리하는 `ssh -L`에만 켠다.
#MYSQL_SSH_REUSE_EXISTING=false

# --- MySQL -------------------------------------------------------------------
# tunnel을 쓰면 MYSQL_HOST/MYSQL_PORT는 *bastion에서 본* 데이터베이스 주소다.
# pool이 직접 접속하는 주소가 아니라 forwarding 대상이다.
# alias의 LocalForward 대상이 이 값들보다 우선한다.
MYSQL_HOST=db.cluster-ro.example.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASS=your_password

# 비워 두면 multi-DB 모드다 (SHOW DATABASES, 스키마를 넘나드는 쿼리).
# 데이터베이스 이름을 적으면 서버를 그 스키마 하나로 좁힌다.
MYSQL_DB=

# --- 쿼리 상한 ---------------------------------------------------------------
# 모든 읽기는 서버 쪽 시간 상한 아래에서 돌고 최대 5000행을 돌려준다. 둘 다
# 데이터베이스가 아니라 호출자를 보호하므로 운영자 전용이다. 호출자가 자기
# 상한을 푸는 인자는 없다.
#
# 쿼리가 고르는 행이 아니라 RESPONSE에 담기는 행이다. 자르는 지점이 문장
# 다음이라, 자기 LIMIT을 더 크게 들고 온 쿼리도 함께 잘린다. 호출자가 요청한
# 것이면 information_schema를 포함해 무엇이든 적용되고, 서버가 자기 문장으로
# 쓴 읽기만 예외다 — 행을 스스로 삼키는 카탈로그 스캔, 그리고 자르면 행을
# 줄이는 게 아니라 테이블을 감추게 되는 `mysql://tables` 목록.
# 컨텍스트가 큰 클라이언트와 짝지은 profile이라면 올려도 된다.
#MYSQL_MAX_RESPONSE_ROWS=5000
#
# 호출마다 주는 `timeout_seconds` 인자의 상한. 이 환경을 더 빨리 실패시키려면
# 내린다. 10 아래로 내리면 기본 상한도 같이 내려간다.
# MCP 클라이언트 자체의 도구 타임아웃보다 낮게 둬야 클라이언트가 아니라
# 서버가 실패를 보고한다. 클라이언트가 먼저 포기하면 모델에게 아무 단서도
# 남지 않는다.
#MYSQL_MAX_TIMEOUT_SECONDS=30

# 카탈로그가 자기 information_schema를 읽을 때의 시간 상한. 따로 두는 이유는
# 인벤토리 스캔이 선언된 스키마를 한꺼번에 훑는 일이라 대화형 쿼리보다 오래
# 걸리는 게 정상이기 때문이다. 5000행 상한은 여기에 걸리지 않는다.
#MYSQL_CATALOG_TIMEOUT_SECONDS=60

# --- 애플리케이션 지도 -------------------------------------------------------
# 두 변수 모두 모델의 탐색 왕복을 아끼려고 있다. 운영자가 이미 아는 것을
# 적어 두면 SHOW DATABASES로 추측할 일이 없다.

# 어떤 애플리케이션이 어떤 MySQL 스키마를 갖는지. 배치에 관해 사람은 알지만
# 데이터베이스에는 물어볼 수 없는 유일한 것이다. 항목은 `;` 또는 줄바꿈으로
# 나눈다. 쉼표가 아닌 이유는 설명을 문장처럼 쓸 수 있게 하기 위해서다.
# 각 항목은 `app:schema` 또는 `app:schema:설명` 형식이다. 설명에 `;`를 쓸 수
# 없다. 항목이 쪼개진다.
#
# 앱 하나가 여러 번 나와도 된다. 테넌트별 스키마와 공용 스키마를 함께 갖는
# 서비스라면 둘 다 적는다.
#
# migration을 넘어서 살아남을 사실만 적는다. 스키마의 테이블 목록을 여기
# 적으면 모델의 `SHOW TABLES` 한 번을 아끼고는 조용히 낡는다. 그리고 틀린
# 목록은 없느니만 못하다. 이 지도는 확정된 사실로 제시되기 때문이다.
#
# 지도는 도구 설명 뒤에 붙고 `mysql://schemas` 리소스로도 제공된다.
# 설명일 뿐 무엇을 조회할 수 있는지는 제한하지 않는다. 비워 둬도 된다.
#MYSQL_APP_SCHEMAS="billing-api:billing;
#crm-api:crm;
#invoice-worker:billing"

# 이 환경의 데이터와 맞는 코드가 있는 git 브랜치. 도구 설명과 모든 응답
# 배너에 표시된다. 행과 코드를 맞춰 보는 모델이 올바른 리비전을 받게 하기
# 위해서다. profile별 기본값은
# stage/staging/dev/develop -> develop, prod/production -> main.
#MYSQL_CODE_BRANCH=develop

# --- 스키마 카탈로그 ---------------------------------------------------------
# 선언된 스키마의 테이블 인벤토리와, 필요할 때 모으는 컬럼·인덱스·FK
# 메타데이터를 캐시한다. 캐시는 로컬에 있고 profile/대상/사용자별로 나뉘며
# 0600으로 쓰인다. 카탈로그는 MYSQL_APP_SCHEMAS가 선언한 것만 훑으므로,
# 지도를 비우면 이 플래그를 끈 것과 같아진다.
#MYSQL_CATALOG_ENABLED=true

# 카탈로그 디렉터리를 바꾼다. 기본값은 ~/.cache/mcp-mysql-bastion/catalog/
# 아래이고, 파일 이름에 profile과 DB 대상·MySQL 사용자의 해시가 들어간다.
#MYSQL_CATALOG_PATH=/absolute/path/to/catalog-directory

# 캐시된 데이터베이스 메타데이터를 이 시간마다 갱신한다. 기본 24시간.
#MYSQL_CATALOG_TTL_HOURS=24

# 도메인 model.md 파일들이 있는 읽기 전용 git 저장소. 이 값이 없으면 문서
# 축이 꺼진다. ref는 MYSQL_CODE_BRANCH에서 가져온다.
# docs_list는 후보를 이 저장소의 apps/<app>/ 아래로 좁히며, 앱 이름은
# MYSQL_APP_SCHEMAS에서 가져온다. 그 경로에 아무것도 없으면 카탈로그에 있는
# 문서 전부를 돌려주고 응답에 그 이유를 적는다.
#MYSQL_DOCS_REPO=/absolute/path/to/application-repository

# --- 쓰기 권한 ---------------------------------------------------------------
# 넷 다 기본값이 false다. MYSQL_PROFILE이 prod/production이면 값과 무관하게
# false로 강제된다.
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false
MULTI_DB_WRITE_MODE=false

# --- 진단 --------------------------------------------------------------------
# 어떤 MCP 클라이언트에서든 켜도 된다. 모든 로그는 stdout이 아니라 stderr로
# 나간다.
ENABLE_LOGGING=false
